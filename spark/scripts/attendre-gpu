#!/bin/sh
# Attend que CUDA soit vraiment utilisable (au boot le GPU peut ne pas être prêt) — max ~150 s
for i in $(seq 1 30); do
  python3 -c 'import ctypes,sys; sys.exit(ctypes.CDLL("libcuda.so.1").cuInit(0))' 2>/dev/null && exit 0
  echo "GPU pas encore prêt (essai $i)"; sleep 5
done
echo "GPU toujours pas prêt, échec"; exit 1
