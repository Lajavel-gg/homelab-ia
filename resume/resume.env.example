# Copier en /opt/ai-stack/resume/resume.env (le fichier doit exister, même vide).
# Les réglages de la boîte mail sont lus dans /opt/ai-stack/mcpo/mail/mail.env (le même que l'outil mail).

# Libellé Gmail (ou dossier) où les résumés sont rangés
LIBELLE=Résumés du matin

# État du cluster Proxmox : serveurs, machines, stockages, sauvegardes vzdump de la nuit.
# Une clé en lecture seule suffit (rôle PVEAuditor sur « / », voir le README).
PVE_HOST=192.168.0.200
PVE_TOKEN_ID=spark@pve!spark
PVE_TOKEN_SECRET=
PVE_CA=/opt/ai-stack/resume/pve-root-ca.pem

# Services du réseau à tester chaque matin : Nom=adresse, séparés par des virgules.
# Une page d'erreur (401, 404…) compte comme « répond » : on vérifie seulement que le service tourne.
SONDES=Vaultwarden=https://vault.example.com/alive,VPN (wg-easy)=https://wg.example.com,LanguageTool=http://192.168.0.213:8081/v2/languages
