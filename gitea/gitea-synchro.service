[Unit]
Description=Synchro GitHub -> Gitea (branche principale et tags)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=gitea-synchro
Group=gitea-synchro
ExecStart=/usr/local/bin/synchro_github.py
TimeoutStartSec=30min
# Le script n'a besoin que de son cache et du réseau.
StateDirectory=gitea-synchro
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/gitea-synchro
