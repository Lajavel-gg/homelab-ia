# Réglages de synchro_github.py : à copier dans /etc/gitea-synchro.env (propriétaire gitea-synchro, mode 600).
# Clé GitHub « fine-grained », LECTURE SEULE : All repositories, Contents = Read, Metadata = Read. Rien d'autre.
GITHUB_TOKEN=github_pat_a-changer
GITHUB_PROPRIO=Lajavel-gg
# Clé Gitea du compte « synchro » (droits : write:repository, write:organization)
GITEA_TOKEN=a-changer
GITEA_USER=synchro
GITEA_URL=http://127.0.0.1:3000
GITEA_ORG=projets
CACHE=/var/lib/gitea-synchro
# Repos GitHub à ne pas copier, séparés par des virgules (ex. Lajavel-gg pour le profil)
EXCLURE=Lajavel-gg
