# Secrets de LiteLLM (fichier .env, mode 600, jamais dans git)
LITELLM_MASTER_KEY=sk-a-changer
LITELLM_SALT_KEY=a-changer
POSTGRES_PASSWORD=a-changer
DATABASE_URL=postgresql://litellm:a-changer@db:5432/litellm
# clé de la porte réservée du Caddy du Spark (/chef et /ouvriers)
CLE_SPARK=a-changer
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
LITELLM_TELEMETRY=False
STORE_MODEL_IN_DB=False
