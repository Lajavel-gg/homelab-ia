# Secrets de Gitea (fichier .env, mode 600, jamais dans git). À garder dans Vaultwarden.
# Nom de la VM sur le réseau (doit correspondre au certificat de tls/gitea.crt)
GITEA_DOMAINE=gitea.example.com
# docker run --rm gitea/gitea:1.27.3-rootless gitea generate secret SECRET_KEY
GITEA_SECRET_KEY=a-changer
# docker run --rm gitea/gitea:1.27.3-rootless gitea generate secret INTERNAL_TOKEN
GITEA_INTERNAL_TOKEN=a-changer
